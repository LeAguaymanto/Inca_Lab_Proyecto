<style>
    /* ==========================================================================
       ESTILOS DEL PIE DE PÁGINA (FOOTER)
       ========================================================================== */
    .site-footer {
        background-color: var(--color-primary, #0F172A);
        color: #ffffff;
        padding: 40px 0;
        border-top: 4px solid var(--color-accent, #EA580C); /* Línea naranja superior opcional */
        
        /* Aseguramos que ocupe todo el ancho si hay contenedores globales */
        width: 100vw !important;
        position: relative;
        left: 50%;
        transform: translateX(-50%);
    }

    .footer-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
    }

    /* Columnas */
    .footer-col {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    /* Columna 1: Logo y Marca */
    .footer-brand {
        flex-direction: row;
        align-items: center;
        gap: 15px;
        max-width: 320px;
    }
    
    .footer-logo {
        width: 60px;
        height: 60px;
        object-fit: contain;
        border-radius: 50%; /* Por si necesitas que el fondo blanco del logo sea circular */
    }

    .footer-brand h4 {
        margin: 0 0 4px 0;
        font-size: 1.1rem;
        letter-spacing: 1px;
    }

    .footer-brand p {
        margin: 0;
        font-size: 0.8rem;
        color: #94A3B8;
        line-height: 1.4;
    }

    /* Separadores visuales (Líneas verticales tenues) */
    .footer-divider {
        width: 1px;
        height: 50px;
        background-color: rgba(255, 255, 255, 0.1);
    }

    /* Columna 2: Texto CTA */
    .footer-cta-text h4 {
        margin: 0 0 4px 0;
        font-size: 1rem;
    }

    .footer-cta-text p {
        margin: 0;
        font-size: 0.9rem;
        color: #94A3B8;
    }

    /* Columna 3: Contacto (Iconos) */
    .footer-contact ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .footer-contact li {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.9rem;
        color: #CBD5E1;
    }

    .footer-contact svg {
        width: 16px;
        height: 16px;
        color: var(--color-accent, #EA580C);
    }

    /* Columna 4: Botón */
    .btn-footer {
        background-color: var(--color-accent, #EA580C);
        color: #ffffff;
        text-decoration: none;
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: background 0.3s ease;
    }

    .btn-footer:hover {
        background-color: #C2410C;
    }

    /* Diseño Responsivo (Para tablets y móviles) */
    @media (max-width: 992px) {
        .footer-container {
            flex-wrap: wrap;
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }
        .footer-divider {
            display: none; /* Ocultamos las líneas verticales en móviles */
        }
        .footer-brand {
            max-width: 100%;
        }
    }
</style>

