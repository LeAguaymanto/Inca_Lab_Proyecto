<header class="site-header">
    <div class="header-inner">
        <a class="brand" href="/inicio">
            <img src="/imagenes/logo_ikalab/incalab_logo.png" alt="Logo de InkaLab">
            <span>InkaLab</span>
        </a>
        <nav class="main-nav" aria-label="Navegacion principal">
            <a class="<%= currentPage === 'inicio' ? 'active' : '' %>" href="/inicio">Inicio</a>
            <a class="<%= currentPage === 'capacitaciones' ? 'active' : '' %>" href="/Capacitaciones">Capacitaciones</a>
            <a class="<%= currentPage === 'contactos' ? 'active' : '' %>" href="/contactos">Contactos</a>
        </nav>
    </div>
</header>

<style>
    :root {
        --ink: #183642;
        --muted: #5d7379;
        --accent: #e07a42;
        --paper: #f8f5ef;
        --line: #d9e1dd;
    }

    * { box-sizing: border-box; }

    body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--paper);
        color: var(--ink);
        font-family: Georgia, 'Times New Roman', serif;
    }

    .site-header {
        border-bottom: 1px solid var(--line);
        background: rgba(248, 55, 0, 0.80);
    }

    .header-inner {
        width: min(1100px, calc(100% - 40px));
        min-height: 84px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        color: var(--ink);
        font-size: 1.65rem;
        font-weight: bold;
        text-decoration: none;
    }

    .brand img {
        width: 42px;
        height: 42px;
        display: block;
        object-fit: contain;
    }

    .main-nav {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .main-nav a {
        border-bottom: 2px solid transparent;
        color: var(--muted);
        padding: 10px 12px;
        text-decoration: none;
        transition: color 160ms ease, border-color 160ms ease;
    }

    .main-nav a:hover,
    .main-nav a.active {
        border-color: var(--accent);
        color: var(--ink);
    }

    main {
        width: min(1100px, calc(100% - 40px));
        flex: 1;
        margin: 0 auto;
        padding: 64px 0;
    }

    @media (max-width: 600px) {
        .header-inner {
            align-items: flex-start;
            flex-direction: column;
            gap: 8px;
            padding: 20px 0;
        }

        .main-nav {
            flex-wrap: wrap;
            margin-left: -12px;
        }

        main { padding: 40px 0; }
    }
</style>
